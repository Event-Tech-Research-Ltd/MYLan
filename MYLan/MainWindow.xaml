<Window x:Class="DhcpFieldServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MYLan — DHCP Field Server  v1.1" Height="520" Width="720"
        MinHeight="400" MinWidth="600"
        Background="#1E1E2E">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D44"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="MYLan" FontSize="20" FontWeight="Bold" Foreground="#00B4D8"
                           VerticalAlignment="Center"/>
                <TextBlock Text="  DHCP Field Server" FontSize="14" Foreground="#888"
                           VerticalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Name="StatusDot" Width="10" Height="10" Fill="#888" Margin="0,0,8,0"/>
                <TextBlock Name="StatusText" Text="Idle" Foreground="#E0E0E0" FontWeight="SemiBold" FontSize="13"/>
            </StackPanel>
        </Grid>

        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="#16213E" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="Server Network Adapter" Foreground="#AAA" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox Name="ServerNicCombo" Margin="0,0,0,4"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="10,0,0,0" VerticalAlignment="Center">
                <Button Name="StartBtn" Content="▶  Start" Width="120" Style="{StaticResource DarkButton}"
                        Background="#0F3460" Click="StartBtn_Click" Margin="0,0,0,6"/>
                <Button Name="StopBtn" Content="■  Stop" Width="120" Style="{StaticResource DarkButton}"
                        Background="#6B1D1D" Click="StopBtn_Click" IsEnabled="False" Margin="0,0,0,6"/>
                <Button Name="RefreshBtn" Content="↻  Refresh NICs" Width="120" Style="{StaticResource DarkButton}"
                        Background="#2A2A4A" FontSize="11" Click="RefreshBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main content: Log + Leases -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Log -->
            <Border Grid.Column="0" Background="#16213E" CornerRadius="8" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Activity Log" Foreground="#E0E0E0" FontWeight="SemiBold" FontSize="13"/>
                        <Button Content="Clear" HorizontalAlignment="Right" FontSize="10"
                                Background="Transparent" Foreground="#666" BorderThickness="0"
                                Cursor="Hand" Click="ClearLogBtn_Click"/>
                    </Grid>
                    <TextBox Name="LogBox"
                             FontFamily="Consolas" FontSize="11"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             Background="#111830" Foreground="#A8D8A8"
                             BorderBrush="#1A2A4A" Padding="8"/>
                </DockPanel>
            </Border>

            <!-- Leases -->
            <Border Grid.Column="2" Background="#16213E" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Active Leases" Foreground="#E0E0E0"
                               FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <DataGrid Name="LeaseGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="Transparent"
                              Foreground="#E0E0E0"
                              BorderThickness="0"
                              FontFamily="Consolas" FontSize="11"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MAC Address" Binding="{Binding Mac}" Width="*"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="100"/>
                            <DataGridTextColumn Header="Expires" Binding="{Binding Expiry}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Margin="0,8,0,0"
                   Text="Run as Administrator. Leases persist to mylan-leases.json."
                   FontSize="11" Foreground="#666"/>
    </Grid>
</Window>
